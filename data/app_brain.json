  "comparison": {
    "enabled": true,
    "default_sort": "relevance_to_user_need",
    "never_sort_as_best_overall": true,
    "dimensions": [
      "total_cost",
      "exchange_rate",
      "recipient_amount",
      "delivery_speed",
      "delivery_method",
      "payment_method",
      "availability",
      "important_conditions"
    ],
    "calculation": {
      "total_cost": "amount_sent_plus_fee",
      "recipient_amount": "provider_verified_recipient_amount",
      "effective_cost": "amount_sent_plus_fee_minus_value_delivered_after_currency_conversion",
      "never_estimate_missing_values": true
    },
    "priority_mapping": {
      "fastest": [
        "delivery_speed",
        "availability",
        "delivery_method"
      ],
      "urgent": [
        "delivery_speed",
        "availability"
      ],
      "save": [
        "fee",
        "effective_cost"
      ],
      "recipient_gets_more": [
        "recipient_amount",
        "exchange_rate",
        "fee"
      ],
      "balanced": [
        "recipient_amount",
        "fee",
        "delivery_speed",
        "availability"
      ],
      "compare_all": [
        "total_cost",
        "exchange_rate",
        "recipient_amount",
        "delivery_speed",
        "delivery_method",
        "conditions"
      ]
    }
  },

