{
  "app":{
    "name":"REMESAS",
    "brand":"May Roga LLC",
    "version":"4.0.0",
    "schema_version":"4.0",
    "environment":"production",
    "default_language":"es",
    "supported_languages":["es","en"],
    "origin_country":"US",
    "target_region":"LATAM",
    "purpose":"Ayudar al usuario a entender, organizar y planificar remesas y decisiones personales relacionadas con su dinero sin inventar datos comerciales.",
    "privacy_mode":"no_durable_personal_data_storage"
  },
  "experience":{
    "default_entry":"home",
    "mobile_first":true,
    "simple_language":true,
    "show_only_relevant_options":true,
    "preserve_four_providers":true,
    "functional_controls_only":true,
    "entry_points_independent":true
  },
  "opening":{
    "title":{
      "es":"TU DINERO, MÁS CLARO",
      "en":"YOUR MONEY, CLEARER"
    },
    "subtitle":{
      "es":"Entiende tu necesidad, compara lo que puede verificarse y continúa en la fuente oficial.",
      "en":"Understand your need, compare what can be verified, and continue to the official source."
    },
    "primary_actions":[
      {
        "id":"send_money",
        "label":{"es":"Enviar dinero","en":"Send money"},
        "action":"remittance"
      },
      {
        "id":"my_money",
        "label":{"es":"Mi dinero","en":"My money"},
        "action":"money"
      },
      {
        "id":"help",
        "label":{"es":"No entiendo","en":"I need help"},
        "action":"help"
      }
    ],
    "notice":{
      "es":"REMESAS no inventa tarifas, tasas, tiempos ni disponibilidad. Cuando esos datos no están verificados, te dirige al proveedor oficial.",
      "en":"REMESAS does not invent fees, rates, delivery times, or availability. When those data are not verified, it directs you to the official provider."
    }
  },
  "conversation_logic":{
    "goal":"identify_need_then_collect_only_information_that_changes_the_next_action",
    "entry_without_form":true,
    "free_text_parser":true,
    "preserve_user_context":true,
    "ask_only_missing_fields":true,
    "do_not_require_unused_fields":true,
    "remittance_required_fields":["amount","destination_country"],
    "optional_remittance_fields":["priority","urgency","delivery_method","payment_method","recipient_amount_target","special_need","frequency"],
    "functional_reaction_rule":"every_question_and_control_must_solve_calculate_record_clarify_search_or_route"
  },
  "kernel":{
    "version":"4.0.0",
    "mode":"rules_first",
    "commercial_data_authority":"providers.json",
    "commercial_data_rule":"only_verified_provider_data_may_be_presented_as_current",
    "unverified_handoff_allowed":true,
    "local_data_authority":"client_local_storage",
    "server_durable_storage":false,
    "provider_count":4
  },
  "providers":{
    "source_file":"data/providers.json",
    "required_ids":["western_union","moneygram","remitly","xoom"],
    "selection_rule":"preserve_all_supported_providers_for_the_destination; do_not_rank_when_commercial_data_is_unverified",
    "display_rule":"show_concise_relevant_provider_options",
    "official_urls_only":true
  },
  "countries":{
    "default_currency":"USD",
    "supported":[
