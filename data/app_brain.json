{
  "app": {
    "id": "remesas_latinoamerica",
    "name": "REMESAS",
    "version": "1.0.0",
    "schema_version": "1.0",
    "status": "production",
    "default_language": "es",
    "supported_languages": ["es", "en"],
    "origin_market": "US",
    "target_region": "LATAM",
    "subscription": {
      "currency": "USD",
      "price": 15.99,
      "period": "1_month",
      "type": "subscription",
      "provider": "stripe",
      "description": {
        "es": "Acceso durante un mes a la plataforma de comparación y asistencia para remesas.",
        "en": "One month of access to the remittance comparison and assistance platform."
      }
    }
  },

  "product_promise": {
    "es": "Te ayudamos a encontrar una opción de envío que encaje con lo que necesitas hoy.",
    "en": "We help you find a sending option that fits what you need today.",
    "principles": [
      "simplify",
      "compare",
      "verify",
      "explain",
      "guide",
      "protect_user_control"
    ],
    "never_promise": [
      "guaranteed_delivery",
      "guaranteed_exchange_rate",
      "guaranteed_fee",
      "guaranteed_approval",
      "guaranteed_availability"
    ]
  },

  "experience": {
    "client_should_see": [
      "what_they_need",
      "relevant_options",
      "simple_comparison",
      "important_difference",
      "next_action",
      "final_check"
    ],
    "client_should_not_see": [
      "internal_kernel",
      "internal_rules",
      "scoring_formula",
      "provider_ranking_formula",
      "api_details",
      "source_processing",
      "internal_validation_logic",
      "debug_information",
      "raw_provider_payloads",
      "technical_errors",
      "private_system_prompts",
      "server_state"
    ],
    "tone": {
      "es": [
        "claro",
        "tranquilo",
        "directo",
        "humano",
        "practico",
        "sin_alarmismo"
      ],
      "en": [
        "clear",
        "calm",
        "direct",
        "human",
        "practical",
        "non_alarmist"
      ]
    },
    "interaction_rules": {
      "one_thing_at_a_time": true,
      "minimize_questions": true,
      "ask_only_if_answer_changes_result": true,
      "allow_free_text_need": true,
      "allow_skip_when_information_is_not_required": true,
      "always_explain_unfamiliar_term_on_request": true,
      "never_force_user_to_understand_provider_terminology": true
    }
  },

  "opening": {
    "primary_question": {
      "es": "¿QUÉ NECESITAS HOY?",
      "en": "WHAT DO YOU NEED TODAY?"
    },
    "secondary_text": {
      "es": "Dime cuánto quieres enviar y qué es lo más importante para ti.",
      "en": "Tell me how much you want to send and what matters most to you."
    },
    "amount": {
      "required": false,
      "type": "money",
      "currency_default": "USD",
      "placeholder": {
        "es": "¿Cuánto quieres enviar?",
        "en": "How much do you want to send?"
      }
    },
    "priorities": [
      {
        "id": "fastest",
        "icon": "⚡",
        "label": {
          "es": "LO NECESITO RÁPIDO",
          "en": "I NEED IT FAST"
        }
      },
      {
        "id": "save",
        "icon": "💰",
        "label": {
          "es": "QUIERO AHORRAR",
          "en": "I WANT TO SAVE"
        }
      },
      {
        "id": "recipient_gets_more",
        "icon": "💵",
        "label": {
          "es": "QUIERO QUE RECIBA MÁS",
          "en": "I WANT THEM TO RECEIVE MORE"
        }
      },
      {
        "id": "urgent",
        "icon": "🚨",
        "label": {
          "es": "ES URGENTE",
          "en": "IT'S URGENT"
        }
      },
      {
        "id": "balanced",
        "icon": "⚖️",
        "label": {
          "es": "MEJOR EQUILIBRIO",
          "en": "BEST BALANCE"
        }
      },
      {
        "id": "compare_all",
        "icon": "🔎",
        "label": {
          "es": "QUIERO COMPARAR",
          "en": "COMPARE OPTIONS"
        }
      },
      {
        "id": "other",
        "icon": "✍️",
        "label": {
          "es": "OTRA NECESIDAD",
          "en": "OTHER NEED"
        }
      }
    ],
    "free_text": {
      "enabled": true,
      "placeholder": {
        "es": "También puedes escribir lo que necesitas...",
        "en": "You can also write what you need..."
      },
      "examples": {
        "es": [
          "Quiero mandar $500 a México y que llegue hoy.",
          "Necesito mandar dinero a Cuba.",
          "Quiero que mi familia reciba lo máximo posible.",
          "Quiero comparar antes de enviar.",
          "Necesito mandar una cantidad grande."
        ],
        "en": [
          "I want to send $500 to Mexico and have it arrive today.",
          "I need to send money to Cuba.",
          "I want my family to receive as much as possible.",
          "I want to compare before sending.",
          "I need to send a large amount."
        ]
      }
    }
  },

  "conversation_logic": {
    "goal": "obtain_only_information_that_can_change_available_or_relevant_options",
    "question_priority": [
      "amount",
      "destination",
      "urgency",
      "delivery_method",
      "payment_method",
      "special_requirement"
    ],
    "do_not_ask": [
      "information_that_does_not_change_results",
      "information_already_provided",
      "information_that_can_be_requested_later_by_provider",
      "unnecessary_personal_information"
    ],
    "question_rules": [
      {
        "id": "destination_required_for_comparison",
        "condition": "destination_missing",
        "action": "ask_destination"
      },
      {
        "id": "amount_required_for_price_comparison",
        "condition": "amount_missing",
        "action": "ask_amount"
      },
      {
        "id": "delivery_method",
        "condition": "available_options_change_by_delivery_method",
        "action": "ask_only_if_needed"
      },
      {
        "id": "urgency",
        "condition": "priority_is_speed_or_urgent",
        "action": "confirm_required_delivery_time_only_if_needed"
      }
    ]
  },

  "kernel": {
    "name": "temporary_remittance_kernel",
    "server_persistence": false,
    "clear_after_session": true,
    "client_local_storage_allowed": true,
    "fields": {
      "session_id": "temporary",
      "language": "es",
      "amount": null,
      "send_currency": "USD",
      "destination_country": null,
      "destination_region": null,
      "priority": null,
      "urgency": null,
      "delivery_method": null,
      "payment_method": null,
      "recipient_amount_target": null,
      "special_need": null,
      "parsed_user_need": null,
      "candidate_providers": [],
      "verified_results": [],
      "selected_option": null,
      "final_check": {},
      "current_step": "opening"
    },
    "never_store": [
      "full_recipient_identity",
      "recipient_account_number",
      "recipient_card_number",
      "bank_password",
      "payment_card_number",
      "cvv",
      "government_id_number",
      "provider_password",
      "authentication_code",
      "full_sensitive_transaction_credentials"
    ],
    "session_end": [
      "clear_kernel",
      "clear_sensitive_runtime_data"
    ]
  },

  "local_storage": {
    "enabled": true,
    "purpose": [
      "language_preference",
      "app_version",
      "brain_version",
      "user_interface_preferences",
      "optional_non_sensitive_preferences",
      "temporary_session_recovery"
    ],
    "never_store": [
      "payment_credentials",
      "bank_credentials",
      "government_identifiers",
      "provider_passwords",
      "authentication_codes",
      "full_recipient_sensitive_data"
    ],
    "keys": {
      "language": "remesas_language",
      "app_version": "remesas_app_version",
      "brain_version": "remesas_brain_version",
      "preferences": "remesas_preferences",
      "session": "remesas_session",
      "consent": "remesas_consent"
    },
    "user_controls": {
      "delete_local_data": true,
      "label": {
        "es": "BORRAR MIS DATOS DE ESTE DISPOSITIVO",
        "en": "DELETE MY DATA FROM THIS DEVICE"
      }
    }
  },

  "brain_loading": {
    "source": "data/app_brain.json",
    "load_on_start": true,
    "validate_on_start": true,
    "cache_locally": true,
    "update_when_version_changes": true,
    "never_use_invalid_brain": true,
    "fallback_mode": "safe_read_only",
    "required_sections": [
      "app",
      "experience",
      "opening",
      "conversation_logic",
      "kernel",
      "providers",
      "countries",
      "comparison",
      "validation",
      "security",
      "languages"
    ]
  },

  "data_truth": {
    "core_rule": "never_invent_data",
    "commercial_data_requires_verification": true,
    "required_metadata": [
      "source",
      "verified_at",
      "status"
    ],
    "statuses": [
      "verified",
      "stale",
      "unavailable",
      "restricted",
      "not_applicable"
    ],
    "stale_data_must_not_be_presented_as_current": true,
    "unknown_value": null,
    "if_data_missing": {
      "action": "do_not_guess",
      "client_message": {
        "es": "No pudimos confirmar ese dato ahora.",
        "en": "We could not confirm that information right now."
      }
    }
  },

