      "es": "REVISA ESTOS DATOS ANTES DE CONTINUAR.",
      "en": "REVIEW THESE DETAILS BEFORE CONTINUING."
    },
    "do_not_block_for": [
      "optional_information"
    ]
  },

  "risk_handling": {
    "purpose": "inform_without_creating_fear",
    "style": "calm",
    "never_use_alarmist_language": true,
    "message_patterns": {
      "unknown": {
        "es": "No pudimos confirmar este dato ahora.",
        "en": "We could not confirm this information right now."
      },
      "changed": {
        "es": "Este dato puede cambiar. Revisa el valor mostrado por el proveedor antes de enviar.",
        "en": "This information can change. Check the value shown by the provider before sending."
      },
      "restriction": {
        "es": "Esta opción tiene una condición que debes revisar antes de continuar.",
        "en": "This option has a condition you should review before continuing."
      },
      "recipient_data": {
        "es": "Es importante escribir los datos del destinatario exactamente como los solicita el proveedor.",
        "en": "Enter the recipient's information exactly as requested by the provider."
      }
    }
  },

  "special_cases": {
    "large_amount": {
      "enabled": true,
      "action": "verify_provider_limits_and_requirements",
      "client_message": {
        "es": "Para esta cantidad pueden existir condiciones adicionales. Vamos a comprobarlas antes de continuar.",
        "en": "This amount may have additional conditions. We will check them before you continue."
      }
    },
    "cuba": {
      "enabled": true,
      "requires_corridor_specific_verification": true,
      "requires_provider_specific_verification": true,
      "never_assume_availability": true,
      "never_assume_delivery_method": true,
      "never_assume_fee": true,
      "never_assume_exchange_rate": true,
      "client_message": {
        "es": "Para Cuba, las opciones pueden depender especialmente del proveedor y del método de entrega. Vamos a comprobar las opciones disponibles.",
        "en": "For Cuba, available options can depend especially on the provider and delivery method. We will check the available options."
      }
    },
    "promotions": {
      "enabled": true,
      "must_show_expiration_when_known": true,
      "must_not_present_promotion_as_standard_price": true
    }
  },

  "provider_handoff": {
    "enabled": true,
    "app_does_not_execute_transfer": true,
    "external_provider_required": true,
    "before_redirect": [
      "show_selected_option",
      "show_final_check",
      "show_provider_name",
      "show_that_provider_is_external"
    ],
