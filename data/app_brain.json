  "comparison":{
    "currency":"USD",
    "commercial_fields":["fee","exchange_rate","recipient_amount","estimated_delivery","availability"],
    "verified_only":true,
    "unverified_behavior":"do_not_display_current_commercial_values; show official handoff",
    "compare_dimensions":["destination_country","amount","priority","urgency","delivery_method","payment_method"],
    "no_data_message":{
      "es":"No hay datos comerciales actuales verificados para mostrar. Puedes revisar directamente los proveedores disponibles para este destino.",
      "en":"There are no current verified commercial data to display. You can review the providers available for this destination directly."
    }
  },
  "validation":{
    "amount":{
      "min":0.01,
      "max":1000000
    },
    "destination_required":true,
    "send_currency_default":"USD",
    "supported_languages":["es","en"],
    "commercial_data_must_have":["status","source","verified_at"],
    "official_source_required":true,
    "never_invent":["fees","exchange_rates","delivery_times","availability","requirements"]
  },
  "security":{
    "never_collect":["passwords","CVV","security_codes","bank_login","provider_credentials"],
    "no_secrets_in_client_config":true,
    "official_urls_only":true,
    "validate_session_ids":true,
    "local_storage_for_personal_money_data":true
  },
  "languages":{
    "default":"es",
    "supported":["es","en"],
    "fallback":"es"
  },
  "messages":{
    "session_started":{
      "es":"Sesión iniciada.",
      "en":"Session started."
    },
    "results_ready":{
      "es":"Revisamos las opciones disponibles para tu destino.",
      "en":"We reviewed the options available for your destination."
    },
    "no_results":{
      "es":"No hay datos comerciales actuales verificados para mostrar.",
      "en":"There are no current verified commercial data to display."
    },
    "review_official":{
      "es":"Revisa los datos finales directamente en el sitio oficial antes de enviar dinero.",
      "en":"Review the final details directly on the official site before sending money."
    },
    "invalid_amount":{
      "es":"Indica un monto válido.",
      "en":"Enter a valid amount."
    },
    "destination_required":{
      "es":"Indica el país de destino.",
      "en":"Enter the destination country."
    },
    "local_only":{
      "es":"Tus datos personales de dinero se guardan en este dispositivo; REMESAS no mantiene una base de datos personal permanente.",
      "en":"Your personal money data stays on this device; REMESAS does not maintain a permanent personal database."
    }
  },
  "help_center":{
    "topics":[
      {
        "id":"fees",
        "title":{"es":"Tarifas","en":"Fees"},
        "answer":{
          "es":"Las tarifas pueden depender del monto, método de pago, destino y proveedor. Si no están verificadas en REMESAS, revísalas en la fuente oficial.",
          "en":"Fees can depend on amount, payment method, destination, and provider. If they are not verified in REMESAS, review them on the official source."
        }
      },
      {
        "id":"exchange_rate",
        "title":{"es":"Tasa de cambio","en":"Exchange rate"},
        "answer":{
          "es":"La tasa puede cambiar. REMESAS solo muestra una tasa como actual cuando existe una fuente verificable.",
          "en":"The exchange rate can change. REMESAS shows a rate as current only when a verifiable source exists."
        }
      },
      {
        "id":"delivery",
        "title":{"es":"Cuándo llega","en":"When it arrives"},
        "answer":{
          "es":"El tiempo depende del proveedor, método y destino. Sin verificación actual, debes confirmarlo en el sitio oficial.",
          "en":"Timing depends on the provider, method, and destination. Without current verification, confirm it on the official site."
        }
      },
      {
        "id":"provider_difference",
        "title":{"es":"Diferencia entre proveedores","en":"Provider differences"},
        "answer":{
          "es":"Puedes comparar métodos y datos verificados. Cuando faltan datos comerciales actuales, REMESAS evita declarar un ganador y te muestra el acceso oficial.",
          "en":"You can compare methods and verified data. When current commercial data are missing, REMESAS avoids declaring a winner and shows the official access."
        }
      },
      {
        "id":"mistake_prevention",
        "title":{"es":"Evitar errores","en":"Avoid mistakes"},
        "answer":{
          "es":"Antes de enviar, confirma país, monto, moneda, destinatario, método de entrega y los datos finales mostrados por el proveedor.",
          "en":"Before sending, confirm country, amount, currency, recipient, delivery method, and the final details shown by the provider."
        }
      },
      {
        "id":"security",
        "title":{"es":"Seguridad","en":"Security"},
        "answer":{
          "es":"No introduzcas contraseñas bancarias, CVV, códigos de seguridad ni credenciales de proveedores en REMESAS.",
          "en":"Do not enter bank passwords, CVVs, security codes, or provider credentials into REMESAS."
        }
      }
    ]
  },
