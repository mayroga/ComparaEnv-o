  "corridor_rules":{
    "commercial_data_status":"requires_live_verification",
    "never_assume_provider_availability_from_registry_alone":true,
    "never_assume_delivery_method_from_registry_alone":true,
    "never_assume_fee":true,
    "never_assume_exchange_rate":true,
    "never_assume_recipient_amount":true,
    "never_assume_delivery_time":true
  },
  "quote_schema":{
    "required":["provider_id","origin_country","destination_country","send_amount","send_currency","fee","exchange_rate","recipient_amount","recipient_currency","delivery_method","delivery_time","source","verified_at","status"],
    "status_values":["verified","unverified","unavailable","expired"]
  },
  "comparison_rules":{
    "compare_only_verified_commercial_data":true,
    "never_fill_missing_values":true,
    "never_use_old_quote":true,
    "never_call_provider_best":true,
    "never_rank_without_user_priority":true,
    "primary_dimension":"recipient_amount",
    "secondary_dimensions":["fee","exchange_rate","delivery_time","delivery_method"],
    "user_controls_priority":true,
    "show_unverified_as_unverified":true
  },
  "decision_support":{
    "purpose":"Help the user understand which provider options are compatible with the user's specific need before sending money.",
    "consider":{
      "amount":true,
      "destination":true,
      "urgency":true,
      "delivery_method":true,
      "payment_method":true,
      "recipient_bank_access":true,
      "recipient_wallet_access":true,
      "first_transfer":true,
      "recurring_transfer":true,
      "special_need":true
    },
    "possible_needs":[
      "fastest",
      "save",
      "recipient_gets_more",
      "urgent",
      "balanced",
      "compare_all"
    ],
    "never_make_unsupported_decision":true
  },
  "verification":{
    "commercial_data_must_show_status":true,
    "commercial_data_must_show_source_when_available":true,
    "commercial_data_must_show_verified_at_when_available":true,
    "expired_data_must_not_be_used_as_current_quote":true,
    "official_provider_source_is_authoritative":true,
    "user_must_be_able_to_open_provider_before_transaction":true
  },
  "audit":{
    "commercial_data_is_not_static":true,
    "official_provider_sources_are_authoritative":true,
    "last_verified_time_should_be_shown":true,
    "provider_link_before_transaction":true
  }
